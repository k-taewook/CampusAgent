# CampusAgent 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 키 값을 채워 넣으세요.
#   cp .env.example .env

# LLM (하나 이상 설정, 자동 감지)
GOOGLE_API_KEY=your-google-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# 외부 공공 API
# 발급: youthcenter.go.kr 마이페이지 → 오픈API / openapi.work.go.kr 회원가입 후 신청
YOUTH_CENTER_API_KEY=your-youth-center-api-key
WORKNET_API_KEY=your-worknet-api-key
